[
  {
    "label": "LaTeX: preview and watch current TeX or Markdown",
    "command": "& \"$env:LOCALAPPDATA\\Programs\\Zed-LaTeX-Tools\\.venv\\Scripts\\python.exe\" -m zed_latex preview \"$env:ZED_FILE\" --watch",
    "shell": {"program": "powershell.exe", "args": ["-NoProfile"]},
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  },
  {
    "label": "Notebook: export saved outputs to HTML",
    "command": "& \"$env:LOCALAPPDATA\\Programs\\Zed-LaTeX-Tools\\.venv\\Scripts\\python.exe\" -m zed_latex export \"$env:ZED_FILE\" --to html",
    "shell": {"program": "powershell.exe", "args": ["-NoProfile"]}
  },
  {
    "label": "Notebook: export saved outputs to PDF",
    "command": "& \"$env:LOCALAPPDATA\\Programs\\Zed-LaTeX-Tools\\.venv\\Scripts\\python.exe\" -m zed_latex export \"$env:ZED_FILE\" --to pdf",
    "shell": {"program": "powershell.exe", "args": ["-NoProfile"]}
  },
  {
    "label": "Notebook: run all cells and export to HTML",
    "command": "& \"$env:LOCALAPPDATA\\Programs\\Zed-LaTeX-Tools\\.venv\\Scripts\\python.exe\" -m zed_latex export \"$env:ZED_FILE\" --to html --execute",
    "shell": {"program": "powershell.exe", "args": ["-NoProfile"]}
  },
  {
    "label": "Notebook: run all cells and export to PDF",
    "command": "& \"$env:LOCALAPPDATA\\Programs\\Zed-LaTeX-Tools\\.venv\\Scripts\\python.exe\" -m zed_latex export \"$env:ZED_FILE\" --to pdf --execute",
    "shell": {"program": "powershell.exe", "args": ["-NoProfile"]}
  }
